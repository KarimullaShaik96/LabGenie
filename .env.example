# ==========================================
# LabGenie AI – Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="LabGenie AI – Intelligent Laboratory Ecosystem"
VERSION="1.0.0"
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key"

# Database (Defaults to SQLite; set to PostgreSQL for production)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/labgenie_db
DATABASE_URL=sqlite:///./labgenie.db

# IBM watsonx.ai (IBM Granite Mandatory AI Model)
# When left empty, LabGenie AI runs in explicit Demo Mode with IBM Granite simulation
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Judge0 Code Execution API (Optional; isolated local sandboxes are enabled by default)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

